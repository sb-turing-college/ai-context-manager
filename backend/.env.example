# ============================================================
# AI Context Manager – Backend environment template
# Copy to backend/.env and fill in your values.
# NEVER commit .env to git.
#
# Local / portfolio path (scripts/start-all.*): use the defaults below.
# Optional UI URL override: ui/.env (VITE_API_URL only) — not required for local start.
# ============================================================

# Database (local SQLite next to the backend process)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# API keys (at least one provider required for LLM calls)
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Mistral moderation (best-effort). Leave empty to disable.
MISTRAL_API_KEY=

# Disclaimer / API terms — set to 1/true for CI/automation only.
# Normal use: accept via the UI (creates backend/.disclaimer_accepted).
DISCLAIMER_ACCEPTED=false

# Server (local bind; start-all / uvicorn use 127.0.0.1)
HOST=127.0.0.1
PORT=8000
DEBUG=true
RELOAD=true

# CORS — Vite dev server origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Features
ENABLE_STREAMING=true
ENABLE_TOOL_USE=true
ENABLE_CONTEXT_CACHE=false

# Logging
LOG_LEVEL=INFO

# Vector search (local paths)
CHROMA_PATH=./chroma_data
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Docker Compose overrides (optional; only if using root docker-compose.yml) ---
# DATABASE_URL=sqlite+aiosqlite:////data/sqlite/app.db
# CHROMA_PATH=/data/chroma
# HOST=0.0.0.0
# DEBUG=false
# RELOAD=false
# CORS_ORIGINS=http://localhost,http://127.0.0.1
